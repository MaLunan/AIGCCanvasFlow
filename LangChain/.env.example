# ── OpenAI（提示词增强 / 脚本拆镜）────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=doubao-pro-32k

# ── 可灵（Kling）文字/图生视频 ────────────────────────────────────────────────
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_URL=https://api.klingai.com

# ── 万象 Wan（DashScope）文字/图生视频 ────────────────────────────────────────
DASHSCOPE_API_KEY=

# ── Replicate（Flux 文字生图 / SVD 图生视频）──────────────────────────────────
REPLICATE_API_TOKEN=

# ── Runway Gen-3（图生视频）──────────────────────────────────────────────────
RUNWAY_API_KEY=

# ── MiniMax（文字生视频）──────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ── 对象存储（MinIO，留空则保存到本地 outputs/ 目录）─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aigc-outputs
MINIO_SECURE=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 应用 ──────────────────────────────────────────────────────────────────────
DEBUG=false
TASK_EXPIRE_SECONDS=86400
